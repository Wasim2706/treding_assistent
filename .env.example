# ==============================================================================
# Indian Stock Market AI Intelligence & Decision Support Application
# Environment Configuration Template
# ==============================================================================

# Application & Security
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=dev-insecure-secret-key-change-in-production-12345
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# TRADING SAFETY - STRICTLY ENFORCED
# The system operates in PAPER TRADING / SIGNAL-ONLY mode.
# Real order execution is permanently blocked unless explicitly configured.
PAPER_TRADING_ONLY=true
REAL_ORDERS_ENABLED=false

# Database Configuration
# Local development fallback: SQLite (zero configuration)
DATABASE_URL=sqlite+aiosqlite:///./trading_assistant.db
# Production Render PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/trading_db

# Redis (Optional queue & cache)
REDIS_URL=redis://localhost:6379/0

# AI Configuration (OpenAI Structured JSON Engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_ARTICLES_PER_AI_CYCLE=10
DAILY_AI_BUDGET_USD=5.00

# News Provider API Keys (Modular News Provider Engine)
NEWS_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
GNEWS_API_KEY=

# Market Data Configuration (Yahoo Finance default, or licensed NSE data)
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER=yahoo

# Telegram Alert Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# Signal Engine Multi-Factor Weights (Must sum to 1.0)
WEIGHT_NEWS=0.35
WEIGHT_TECHNICAL=0.30
WEIGHT_VOLUME=0.15
WEIGHT_MARKET=0.10
WEIGHT_SECTOR=0.10

# Thresholds & Market Schedule
MIN_SIGNAL_CONFIDENCE=65
ALERT_IMPACT_THRESHOLD=70
DEFAULT_RISK_REWARD_TARGET=2.0
TIMEZONE=Asia/Kolkata
NEWS_CYCLE_INTERVAL_SECONDS=300
PRE_MARKET_REPORT_TIME=08:30
NSE_MARKET_OPEN=09:15
NSE_MARKET_CLOSE=15:30

# Frontend Next.js Public URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
